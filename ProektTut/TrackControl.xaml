<UserControl x:Class="Sound_Player.TrackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="http://sharpvectors.codeplex.com/runtime/"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:local="clr-namespace:Sound_Player"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="400">
    <Border x:Name="TrackBorder" Background="Transparent" Padding="10" Margin="5" Cursor="Hand" MouseLeftButtonDown="TrackBorder_MouseLeftButtonDown" CornerRadius="12">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#9D1A1A1A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="tbTrackNumber" Text="1" Foreground="White" FontSize="15" Margin="9,24,0,27" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="60" Height="60">
                    <Border Width="60" Height="60" CornerRadius="15" ClipToBounds="True">
                        <Image x:Name="TrackImage"
                               Source="Resources/Images/placeholder.jpg"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,60,60" RadiusX="10" RadiusY="10"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <Button Width="20" Height="20" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,5,0" Opacity="0.5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="10" Padding="5">
                                    <TextBlock Text="..." FontSize="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <StackPanel Margin="10,0,0,0" Height="44">
                    <TextBlock x:Name="tbTrackTitle" Text="luther (with sza)" FontWeight="Bold" Foreground="White" Height="23"/>
                    <TextBlock x:Name="tbTrackArtist" Text="Kendrick Lamar, SZA" FontSize="12" Foreground="#9B9B9B" Height="22" Width="108"/>
                </StackPanel>
            </StackPanel>
            <ContentControl x:Name="AnimationPlaceholder" Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="tbTrackDuration" Grid.Column="3" Text="03:20" HorizontalAlignment="Center" Width="50" Foreground="#9B9B9B" Margin="0,27,0,27"/>
        </Grid>
    </Border>
</UserControl>
