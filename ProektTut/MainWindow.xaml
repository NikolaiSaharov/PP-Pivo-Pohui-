<Window x:Class="Sound_Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:r="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:local="clr-namespace:Sound_Player" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Music Streaming"
        Height="1080" Width="1920"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <local:SliderValueToHeightConverter x:Key="HeightConverter"/>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#171717"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomVerticalSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- Серый фон слайдера (теперь видимый) -->
                            <Rectangle Fill="#FF424242" 
                                       Width="38" 
                                       Height="147" 
                                       RadiusX="20" 
                                       RadiusY="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"/>

                            <!-- Активная часть (белая полоска) -->
                            <Rectangle x:Name="ActivePart" 
                                       Fill="{TemplateBinding Foreground}" 
                                       Width="38" 
                                       RadiusX="20" 
                                       RadiusY="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom">
                                <Rectangle.Height>
                                    <Binding Path="Value" 
                                             RelativeSource="{RelativeSource TemplatedParent}" 
                                             Converter="{StaticResource HeightConverter}"/>
                                </Rectangle.Height>
                            </Rectangle>

                            <!-- Невидимый Thumb для обработки кликов -->
                            <Track x:Name="PART_Track" VerticalAlignment="Stretch">
                                <Track.Thumb>
                                    <Thumb Width="38" Height="38" Opacity="0"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Основная структура -->
        <Grid Panel.ZIndex="2" x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Grid Grid.Column="1" Grid.Row="0" Background="Black">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопки навигации -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Кнопка в кружке слева -->
                    <Border Width="30" Height="30" Background="#121212" CornerRadius="15">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Width="30" Height="30"
                                Padding="0" Background="Transparent"
                                Click="NavigateBackButton_Click">
                            <svgc:SvgViewbox Source="/Resources/Images/BackArrow_Left.svg"
                                             Width="10" Height="20"/>
                        </Button>
                    </Border>

                    <!-- Кнопка в кружке справа -->
                    <Border Width="30" Height="30" Background="#121212" CornerRadius="15" Margin="20,0,0,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Width="30" Height="30"
                                Padding="0" Background="Transparent"
                                Click="NavigateForwardButton_Click">
                            <svgc:SvgViewbox Source="/Resources/Images/BackArrow_Right.svg" 
                                             Width="10" Height="20"/>
                        </Button>
                    </Border>
                </StackPanel>

                <!--Поиск и кнопка уведомления-->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Margin="350,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="InputBorder" Grid.Column="0"
                            Margin="0,0,20,0" Padding="20,10"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            BorderThickness="2" CornerRadius="30">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Обычное состояние (фон и граница) -->
                                <Setter Property="Background" Value="#121212"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <!-- Градиент при наведении -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3A6299F0" Offset="0.0"/>
                                                    <GradientStop Color="#3A6D4AE7" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6299F0" Offset="0.0"/>
                                                    <GradientStop Color="#6D4AE7" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <!-- Градиент при фокусе внутри (TextBox) -->
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3A6299F0" Offset="0.0"/>
                                                    <GradientStop Color="#3A6D4AE7" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6299F0" Offset="0.0"/>
                                                    <GradientStop Color="#6D4AE7" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox x:Name="SvgImage" Width="25" Height="25" Margin="5" Stretch="Uniform"/>

                            <TextBox x:Name="searchTextBox" 
                                     GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus" PreviewMouseDown="TextBox_PreviewMouseDown"
                                     materialDesign:HintAssist.Hint="Что будем слушать?"
                                     Margin="15,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="White" FontSize="13" FontWeight="Medium"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="#FFFFFF"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     Width="300"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" 
                            Width="55" Height="55" 
                            Background="#121212" 
                            CornerRadius="30">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Width="23" Height="23" Padding="0" 
                                Background="Transparent" BorderBrush="Transparent">
                            <svgc:SvgViewbox Source="/Resources/Images/Bell.svg"/>
                        </Button>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Width="Auto" Height="Auto" Margin="0,0,50,0" Padding="0" 
                            Grid.Column="0" VerticalAlignment="Center">
                        <svgc:SvgViewbox Source="/Resources/Images/Community.svg" Width="230" Height="35" VerticalAlignment="Center"/>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Width="30" Height="30" Background="#171717" CornerRadius="15"  Margin="0,0,10,0">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="15" Height="15" Padding="0"
                                    Click="MinimizeButton_Click">
                                <svgc:SvgViewbox Source="/Resources/Images/CollapseIcon.svg"/>
                            </Button>
                        </Border>

                        <Border Width="30" Height="30" Background="#171717" CornerRadius="15"  Margin="0,0,10,0">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="16" Height="16" Padding="0" 
                                    Click="MaximizeButton_Click">
                                <svgc:SvgViewbox Source="/Resources/Images/ExpandWindow.svg"/>
                            </Button>
                        </Border>

                        <Border Width="30" Height="30" Background="#171717" CornerRadius="15">
                            <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                    Width="16" Height="16" Padding="0" 
                                    Click="CloseButton_Click">
                                <svgc:SvgViewbox Source="/Resources/Images/Cross_Gray.svg"/>
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Левая панель навигации -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                         HorizontalAlignment="Center"
                                         StaysOpen="False"
                                         BorderBrush="Transparent"
                                         Padding="0" 
                                         PopupUniformCornerRadius="15" Grid.Row="0">
                    <materialDesign:PopupBox.ToggleContent>
                        <Border Width="70" Height="70"
                                CornerRadius="35"
                                Background="#121212"
                                ClipToBounds="True">
                            <Border CornerRadius="30" ClipToBounds="True" Margin="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/Images/placeholder.jpg"/>
                                </Border.Background>
                            </Border>
                        </Border>
                    </materialDesign:PopupBox.ToggleContent>

                    <Border Background="#090909" Padding="5" Margin="0" Width="170">
                        <StackPanel Background="#090909" MinHeight="50">
                            <Button Content="Профиль"
                                    Foreground="White"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Stretch"
                                    Click="ProfileButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Border x:Name="background" 
                                                                Background="Transparent" 
                                                                CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Left"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="background" Property="Background" Value="#171717"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left"
                                                    Background="Transparent">
                                            <materialDesign:PackIcon Kind="Account"
                                                                     Foreground="White"
                                                                     Margin="10,0,10,0"
                                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>

                            <Button Content="Настройки"
                                    Foreground="White"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Border x:Name="background" 
                                                                Background="Transparent" 
                                                                CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Left"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="background" Property="Background" Value="#171717"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left"
                                                    Background="Transparent">
                                            <materialDesign:PackIcon Kind="Settings"
                                                                     Foreground="White"
                                                                     Margin="10,0,10,0"
                                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Border>
                </materialDesign:PopupBox>

                <!-- Первый Border с первыми тремя кнопками -->
                <Border x:Name="LeftPanelTop" Grid.Row="1"
                        Background="#121212" CornerRadius="35" Margin="10">
                    <StackPanel Margin="0,20">
                        <Button x:Name="PlanetButton" Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30" Width="30" Padding="0" Margin="0,0,0,30" 
                                Click="PlanetButton_Click">
                            <svgc:SvgViewbox Source="/Resources/Images/Planet.svg"/>
                        </Button>
                        <Button x:Name="SamplesButton" Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30" Width="30" Padding="0" Margin="0,0,0,30"
                                Click="SamplesButton_Click">
                            <svgc:SvgViewbox Source="/Resources/Images/SamplasIcon.svg"/>
                        </Button>
                        <Button x:Name="PersonButton" Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30" Width="30" Padding="0" 
                                Click="PersonButton_Click">
                            <svgc:SvgViewbox Source="/Resources/Images/Waves.svg"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Второй Border с оставшимися кнопками -->
                <Border x:Name="LeftPanelBottom" Grid.Row="2"
                        Background="#121212" CornerRadius="35" Margin="10,0">
                    <StackPanel Margin="0,20">
                        <Button x:Name="PlaylistButton" Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30" Width="30" Padding="0" Margin="0,0,0,30"
                                Click="PlaylistButton_Click">
                            <svgc:SvgViewbox Source="/Resources/Images/Playlist_Gray.svg"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40" Width="40" Padding="0" Margin="0,0,0,20">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFF69B4" Offset="0"/>
                                    <GradientStop Color="#FF87CEEB" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <materialDesign:PackIcon Kind="Heart"
                                             Height="20" Width="20"
                                             Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40" Width="40" Padding="0" Margin="0,0,0,20">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF4169E1" Offset="0"/>
                                    <GradientStop Color="#FF00CED1" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <materialDesign:PackIcon Kind="Clock"
                                             Height="20" Width="20"
                                             Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40" Width="40" Padding="0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF9400D3" Offset="0"/>
                                    <GradientStop Color="#FF4B0082" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <svgc:SvgViewbox Source="/Resources/Images/Logotype_White.svg"
                                             Height="20" Width="20"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Grid.Row="1" Background="#121212" Panel.ZIndex="999" CornerRadius="30,0,0,30">
                <!-- Информационная панель и правая панель -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="361*"/>
                        <RowDefinition Height="559*"/>
                    </Grid.RowDefinitions>

                    <!-- Правая панель -->
                    <Border x:Name="RightPanel"
                            Width="300"
                            HorizontalAlignment="Right"
                            Panel.ZIndex="1000"
                            Grid.RowSpan="2"
                            Visibility="Collapsed"
                            CornerRadius="30">
                    </Border>

                    <!-- Информационная панель -->
                    <Frame x:Name="InfoPanel" 
                           HorizontalAlignment="Left"
                           Width="363"
                           Background="Transparent"
                           Panel.ZIndex="998" 
                           Grid.RowSpan="2" 
                           Margin="-338,0,0,0" 
                           RenderTransformOrigin="0.5,0.5" 
                           Visibility="Collapsed"
                           NavigationUIVisibility="Hidden">
                        <Frame.RenderTransform>
                            <TranslateTransform x:Name="InfoPanelTransform" X="363"/>
                        </Frame.RenderTransform>
                    </Frame>

                    <!-- Кнопка для информационной панели -->
                    <Button x:Name="ToggleInfoButton"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="40" Width="40"
                            Padding="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Click="ToggleInfoPanel_Click"
                            MouseEnter="ToggleInfoButton_MouseEnter"
                            MouseLeave="ToggleInfoButton_MouseLeave"
                            Panel.ZIndex="1001" 
                            Margin="0,79,0,0" 
                            Grid.Row="1">
                        <materialDesign:PackIcon Kind="ChevronLeft"
                                                 Height="24" Width="24"
                                                 Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Нижний плеер -->
            <Border Grid.ColumnSpan="3" Grid.Row="2" Background="#121212" Height="Auto" Width="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#181818" CornerRadius="30" Margin="40,5">
                        <StackPanel Orientation="Horizontal" Margin="30,10,0,10">
                            <Border Margin="0,0,10,0" Height="40" Width="40" CornerRadius="5">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/Images/placeholder.jpg"/>
                                </Border.Background>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Название" Foreground="White"
                                           FontSize="14" FontWeight="Medium" Margin="0,0,0,5"/>
                                <TextBlock Text="Автор" Foreground="#FF808080"
                                           FontSize="12" FontWeight="Medium"/>
                            </StackPanel>

                            <Button x:Name="addToPlaylistButton" Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="15" Height="15" Margin="30,0,30,0" Padding="0"
                                    VerticalAlignment="Top">
                                <svgc:SvgViewbox Source="/Resources/Images/Add.svg"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="80,5,80,0">
                            <Button x:Name="shuffleButton" Style="{StaticResource MaterialDesignFlatButton}"
                                      Width="20" Height="20" Padding="0" Margin="0,0,40,0">
                                <svgc:SvgViewbox Source="/Resources/Images/Mixing.svg"/>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="25" Height="25" Padding="0">
                                <svgc:SvgViewbox Source="/Resources/Images/DoubleArrow_Left.svg"/>
                            </Button>

                            <Button x:Name="playButton" Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="40" Height="40" Margin="40,0"
                                    Background="Transparent" BorderBrush="White" Padding="0">
                                <materialDesign:PackIcon Kind="Play" Foreground="White" Width="40" Height="40"/>
                                <i:Interaction.Behaviors>
                                    <local:PlayPauseButtonBehavior IsPlaying="{Binding IsAudioPlaying, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                </i:Interaction.Behaviors>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                    Width="25" Height="25" Padding="0">
                                <svgc:SvgViewbox Source="/Resources/Images/DoubleArrow_Right.svg"/>
                            </Button>

                            <Button x:Name="repeatButton" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Width="20" Height="20" Padding="0" Margin="40,0,0,0">
                                <svgc:SvgViewbox Source="/Resources/Images/Repeat.svg"/>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1:20" Foreground="#FF808080"
                                       VerticalAlignment="Center"/>

                            <Slider Value="0" Maximum="100"
                                    Style="{StaticResource MaterialDesign3.MaterialDesignSlider}"
                                    Foreground="White"
                                    Grid.Column="1" VerticalAlignment="Center"
                                    ValueChanged="Slider_ValueChanged" Margin="10,0"/>

                            <TextBlock Grid.Column="2" Text="3:20" Foreground="#FF808080"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="50,0,40,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Width="20" Height="20" Padding="0">
                            <svgc:SvgViewbox Source="/Resources/Images/TreeStripes.svg"/>
                        </Button>

                        <Button x:Name="VolumeButton" Style="{StaticResource MaterialDesignFlatButton}" 
                                Width="20" Height="20" Padding="0" Margin="30,0"
                                Click="VolumeButton_Click">
                            <svgc:SvgViewbox Source="/Resources/Images/LowVolume.svg"/>
                        </Button>

                        <!-- Popup с вертикальным слайдером громкости -->
                        <Popup x:Name="VolumePopup" 
                               PlacementTarget="{Binding ElementName=VolumeButton}"
                               Placement="Top" 
                               StaysOpen="False" 
                               AllowsTransparency="True"
                               PopupAnimation="Slide" 
                               VerticalOffset="-35"
                               HorizontalOffset="-10">
                            <Border Width="40" 
                                    Height="150" 
                                    Background="Transparent" 
                                    CornerRadius="20"
                                    Padding="0">
                                <Slider x:Name="VolumeSlider" 
                                        Minimum="0" 
                                        Maximum="122.5" 
                                        Value="50"
                                        Orientation="Vertical" 
                                        Height="147" 
                                        Style="{StaticResource CustomVerticalSliderStyle}"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                            </Border>
                        </Popup>

                        <Button x:Name="ScreenButton" Style="{StaticResource MaterialDesignFlatButton}"
                                Width="25" Height="25" Padding="0"
                                Click="ScreenButton_Click">
                            <svgc:SvgViewbox Source="/Resources/Images/Square_TrackBar.svg"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ScreenContextMenu"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             VerticalOffset="-45">
                                    <ContextMenu.Style>
                                        <Style TargetType="ContextMenu">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ContextMenu">
                                                        <Border Background="Black" CornerRadius="7" Padding="5" Width="220" Height="85">
                                                            <StackPanel Background="Transparent">
                                                                <!-- Открыть мини-плеер -->
                                                                <Button Height="36"
                                                                        Foreground="White"
                                                                        Background="Transparent"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Margin="0,0,0,5"
                                                                        Click="MiniPlayerButton_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Grid Background="Transparent">
                                                                                <Border x:Name="background"
                                                                                        Background="Transparent"
                                                                                        CornerRadius="4"
                                                                                        Padding="8,6">
                                                                                    <ContentPresenter HorizontalAlignment="Left"
                                                                                                      VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="background" Property="Background" Value="#171717"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <!-- Изменения в Image -->
                                                                        <svgc:SvgViewbox Source="/Resources/Images/MiniPlayer.svg"
                                                                                         Width="18" Height="18" Margin="0,0,12,0"
                                                                                         SnapsToDevicePixels="True"
                                                                                         RenderOptions.BitmapScalingMode="HighQuality"/>

                                                                        <TextBlock Text="Открыть мини-плеер"
                                                                                   Foreground="White"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Полный экран -->
                                                                <Button Height="36"
                                                                        Foreground="White"
                                                                        Background="Transparent"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Margin="0"
                                                                        Click="FullScreenButton_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Grid Background="Transparent">
                                                                                <Border x:Name="background"
                                                                                        Background="Transparent"
                                                                                        CornerRadius="4"
                                                                                        Padding="8,6">
                                                                                    <ContentPresenter HorizontalAlignment="Left"
                                                                                                      VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="background" Property="Background" Value="#171717"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <!-- Изменения в Image -->
                                                                        <svgc:SvgViewbox Source="/Resources/Images/FullWindowed.svg"
                                                                                         Width="18" Height="18" Margin="0,0,12,0"
                                                                                         SnapsToDevicePixels="True"
                                                                                         RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        <TextBlock Text="Полный экран"
                                                                                   Foreground="White"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Style>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Frame для контента -->
            <Border Grid.Row="1" Grid.Column="1" Background="#121212" CornerRadius="50" Margin="0,0,10,0">
                <Frame x:Name="PlanetFrame"
                       Navigated="PlanetFrame_Navigated" 
                       BorderBrush="Transparent" HorizontalAlignment="Stretch"/>
            </Border>

            <Frame x:Name="History"
                   Grid.Row="1" Grid.Column="1"
                   Visibility="Collapsed" Width="390" Height="450"
                   BorderBrush="Transparent"
                   VerticalAlignment="Top"
                   Margin="-35,10,0,0"/>
        </Grid>

        <!-- Оверлей для приветственного окна -->
        <Grid x:Name="OverlayGrid" Panel.ZIndex="1000">
            <!-- Здесь будет отображаться OknoPrivet -->
            <Rectangle x:Name="OverlayBackground" Fill="Black" Opacity="0.5" Visibility="Visible"/>
        </Grid>
    </Grid>
</Window>