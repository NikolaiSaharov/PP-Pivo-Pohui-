<Page x:Class="Sound_Player.FullPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sound_Player"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1600"
      Title="FullPlayerPage"
      Background="Black">
    <Page.Resources>
        <LinearGradientBrush x:Key="MenuItemHoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0010C8" Offset="0"/>
            <GradientStop Color="#46CFFF" Offset="0.4"/>
            <GradientStop Color="#4E73FF" Offset="0.8"/>
            <GradientStop Color="#B700FF" Offset="1"/>
            <GradientStop Color="#D200FF" Offset="0.2"/>
        </LinearGradientBrush>
        
        <local:RectConverter x:Key="RectConverter" />

        <!-- Стиль для кнопок плеера -->
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="7,7"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="17">
                            <Grid>
                                <Rectangle x:Name="HoverRect"
                                           Fill="{StaticResource MenuItemHoverGradient}"
                                           Opacity="0"
                                           Margin="-3"
                                           RadiusX="17" RadiusY="17"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Icon" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                    <ContentPresenter ContentSource="Header" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverRect" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="RepeatContextMenu">
            <MenuItem Header="Что думает Meret?" Click="OnMeretMenuItemClick">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Resources/Images/Logotype_White.svg" Width="20" Height="20"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Создать микс" Click="CreateMix_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Resources/Images/AddMix.svg" Width="20" Height="20"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Создать ремикс" Click="Remix_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Resources/Images/AddRemix.svg" Width="20" Height="20"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Добавить в медиатеку" Click="AddToLibrary_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Resources/Images/Playlist_White.svg" Width="20" Height="20"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Добавить в очередь" Click="AddToQueue_Click">
                <MenuItem.Icon>
                    <svgc:SvgViewbox Source="/Resources/Images/TreeStripes.svg" Width="20" Height="20"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Микс по исполнителю" Click="MixByArtist_Click"/>
            <MenuItem Header="Добавить в плейлист" Click="AddToPlaylist_Click"/>
            <MenuItem Header="Поделиться" Click="Share_Click"/>
        </ContextMenu>
    </Page.Resources>

    <Border x:Name="MainBorder" Background="#121212" CornerRadius="30" Margin="10,0,10,0">
        <Grid>
            <MediaElement x:Name="BackgroundVideo"
      Stretch="Fill" 
      HorizontalAlignment="Stretch" 
      VerticalAlignment="Stretch"
      LoadedBehavior="Manual"
      UnloadedBehavior="Stop"
      MediaEnded="BackgroundVideo_MediaEnded"
      Visibility="Visible">
                <MediaElement.Effect>
                    <BlurEffect Radius="200"/>
                </MediaElement.Effect>
                <MediaElement.Clip>
                    <RectangleGeometry RadiusX="30" RadiusY="30">
                        <RectangleGeometry.Rect>
                            <MultiBinding Converter="{StaticResource RectConverter}">
                                <Binding ElementName="BackgroundVideo" Path="ActualWidth"/>
                                <Binding ElementName="BackgroundVideo" Path="ActualHeight"/>
                            </MultiBinding>
                        </RectangleGeometry.Rect>
                    </RectangleGeometry>
                </MediaElement.Clip>
            </MediaElement>
            <Rectangle >
                <Rectangle.Fill>
                    <VisualBrush Visual="{Binding ElementName=MainBorder}">
                        <VisualBrush.Transform>
                            <TranslateTransform X="0" Y="0"/>
                        </VisualBrush.Transform>
                    </VisualBrush>
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <BlurEffect Radius="30"/>
                </Rectangle.Effect>
            </Rectangle>
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0,25,30,0">
                <Button x:Name="PreviousButton" 
                        Style="{StaticResource PlayerButtonStyle}" 
                        Width="35" Height="40" Padding="0" Margin="0,0,10,0"
                        Click="PreviousButton_Click"
                        Foreground="White">
                    <svgc:SvgViewbox Source="/Resources/Images/pleer1.svg" Width="20" Height="20"/>
                </Button>
                <Button x:Name="PlayPauseButton" 
                        Style="{StaticResource PlayerButtonStyle}" 
                        Width="35" Height="40" Padding="0" Margin="0,0,10,0"
                        Click="PlayPauseButton_Click">
                    <svgc:SvgViewbox Source="/Resources/Images/pleer2.svg" Width="20" Height="20"/>
                </Button>
                <Button x:Name="NextButton" 
                        Style="{StaticResource PlayerButtonStyle}" 
                        Width="35" Height="40" Padding="0" Margin="0,0,10,0"
                        Click="NextButton_Click">
                    <svgc:SvgViewbox Source="/Resources/Images/pleer3.svg" Width="20" Height="20"/>
                </Button>
                <!-- Разделительная полоска -->
                <Rectangle Width="1" Height="20" Fill="#808080" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="StopButton" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Width="35" Height="40" Padding="0" Margin="0,0,10,0"
                        Click="StopButton_Click">
                    <svgc:SvgViewbox Source="/Resources/Images/pleer4.svg" Width="20" Height="20"/>
                </Button>
                <Button x:Name="RepeatButton" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Width="35" Height="40" Padding="0"
                        Click="RepeatButton_Click"
                        ContextMenu="{StaticResource RepeatContextMenu}"
                        ContextMenuService.Placement="Bottom">
                    <svgc:SvgViewbox Source="/Resources/Images/qwert5.svg" Width="20" Height="20"/>
                </Button>
            </StackPanel>

            <!-- Статичная обложка в центре -->
            <Border x:Name="TrackCoverBorder" Width="400" Height="400" CornerRadius="40" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Background>
                    <ImageBrush x:Name="CoverImageBrush" ImageSource="/Resources/Images/FullPleer.jpg" Stretch="UniformToFill"/>
                </Border.Background>
                <MediaElement x:Name="TrackVideoPlayer"
  Stretch="UniformToFill"
  LoadedBehavior="Manual"
  UnloadedBehavior="Stop"
  MediaEnded="TrackVideo_MediaEnded"
  Visibility="Collapsed">
                    <MediaElement.Effect>
                        <BlurEffect Radius="200"/>
                    </MediaElement.Effect>
                    <MediaElement.Clip>
                        <RectangleGeometry RadiusX="40" RadiusY="40">
                            <RectangleGeometry.Rect>
                                <MultiBinding Converter="{StaticResource RectConverter}">
                                    <Binding ElementName="TrackCoverBorder" Path="ActualWidth"/>
                                    <Binding ElementName="TrackCoverBorder" Path="ActualHeight"/>
                                </MultiBinding>
                            </RectangleGeometry.Rect>
                        </RectangleGeometry>
                    </MediaElement.Clip>
                </MediaElement>

            </Border>
        </Grid>
    </Border>
</Page>
