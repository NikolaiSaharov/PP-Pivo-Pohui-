<Page x:Class="Sound_Player.AdvancedSearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:r="http://sharpvectors.codeplex.com/runtime/"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sound_Player"
      mc:Ignorable="d"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Title="AdvancedSearchPage">
    <Page.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Foreground}" 
                                            Width="8"
                                            CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ScrollViewer -->
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Page.Resources>
    
    <Grid>
        <Border CornerRadius="20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" Opacity="0.9">
                    <GradientStop Color="#ED22FF" Offset="0.0"/>
                    <GradientStop Color="#A40DF5" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Padding="5" BorderThickness="2" BorderBrush="White" CornerRadius="5">
                            <svgc:SvgViewbox Source="/Resources/Images/Arrow_Up_Search.svg" Height="15" Width="20"/>
                        </Border>
                        <Border Padding="5" BorderThickness="2" BorderBrush="White" CornerRadius="5" 
                                Margin="10,0,0,0">
                            <svgc:SvgViewbox Source="/Resources/Images/Arrow_Down_Search.svg" Height="15" Width="20"/>
                        </Border>
                        <TextBlock Text="Перейти"
                                   FontWeight="Medium" Foreground="White" FontSize="15"
                                   Width="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Padding="20,5" BorderThickness="2" BorderBrush="White" CornerRadius="5">
                            <TextBlock Text="Enter"
                                       FontWeight="Medium" Foreground="White" FontSize="15"
                                       Width="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Открыть"
                                   FontWeight="Medium" Foreground="White" FontSize="15"
                                   Width="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border Padding="20,5" BorderThickness="2" BorderBrush="White" CornerRadius="5">
                            <TextBlock Text="Shift"
                                       FontWeight="Medium" Foreground="White" FontSize="15"
                                       Width="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Padding="20,5" BorderThickness="2" BorderBrush="White" CornerRadius="5" 
                                Margin="10,0,0,0">
                            <TextBlock Text="Enter"
                                       FontWeight="Medium" Foreground="White" FontSize="15"
                                       Width="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Слушать"
                                   FontWeight="Medium" Foreground="White" FontSize="15"
                                   Width="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
               
                <ScrollViewer Grid.Row="1" Margin="0,40,0,0">
                    <WrapPanel>
                        <!--Сделать карточки треков-->
                    </WrapPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
