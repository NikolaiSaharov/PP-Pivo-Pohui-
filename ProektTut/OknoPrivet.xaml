<UserControl x:Class="Sound_Player.OknoPrivet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Key="WelcomeAnimation">
            <!-- Анимация затемнения -->
            <DoubleAnimation Storyboard.TargetName="BackgroundOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.3" Duration="0:0:1"/>

            <DoubleAnimation Storyboard.TargetName="WelcomeWindow"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeWindow"
                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                             From="0.8" To="1" Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeWindow"
                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.8" To="1" Duration="0:0:1"/>

            <DoubleAnimation Storyboard.TargetName="WelcomeText"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1"
                             BeginTime="0:0:1"/>
            <ThicknessAnimation Storyboard.TargetName="WelcomeText"
                               Storyboard.TargetProperty="Margin"
                               From="0,20,0,0" To="0,0,0,0" Duration="0:0:1"
                               BeginTime="0:0:1"/>

            <DoubleAnimation Storyboard.TargetName="UserAvatar"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1"
                             BeginTime="0:0:1.5"/>
            <ThicknessAnimation Storyboard.TargetName="UserAvatar"
                               Storyboard.TargetProperty="Margin"
                               From="0,20,0,0" To="0,0,0,0" Duration="0:0:1"
                               BeginTime="0:0:1.5"/>

            <DoubleAnimation Storyboard.TargetName="WelcomeWindow"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:1"
                             BeginTime="0:0:4"/>
            <DoubleAnimation Storyboard.TargetName="BackgroundOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0" Duration="0:0:1"
                             BeginTime="0:0:2"/>
        </Storyboard>

        <Style TargetType="TextBlock" x:Key="WelcomeTextStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="36"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LogoTextStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="24"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainGrid">
        <!-- Градиентный фон с более яркими и сочными цветами -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2A4A9F" Offset="0"/>
                    <!-- Насыщенный тёмно-синий -->
                    <GradientStop Color="#3E6BCF" Offset="0.5"/>
                    <!-- Яркий средний синий -->
                    <GradientStop Color="#5A8CFF" Offset="1"/>
                    <!-- Сочный светло-синий -->
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Затемнение фона -->
        <Rectangle x:Name="BackgroundOverlay" Fill="Black" Opacity="0"/>

        <!-- Основной контейнер -->
        <Grid x:Name="WelcomeContainer" VerticalAlignment="Stretch" HorizontalAlignment="Center">
            <Grid x:Name="WelcomeWindow" 
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                </Grid.RenderTransform>

                <!-- Логотип GILS с иконкой (вверху) -->
                <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top" 
                            Margin="0,120,0,0">
                    <!-- Иконка -->
                    <svgc:SvgViewbox Source="/Resources/Images/Logotype_White.svg"
                                     Width="64" Height="64"
                                     Margin="0,0,0,10" 
                                     HorizontalAlignment="Center"/>
                    <!-- Текст GILS -->
                    <TextBlock Text="GILS"
                               Style="{StaticResource LogoTextStyle}"/>
                </StackPanel>

                <!-- Центральная часть с аватаркой и текстом (по центру) -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center">
                    <!-- Аватарка пользователя (пустая) -->
                    <Border x:Name="UserAvatar"
                            Width="80" Height="80" 
                            CornerRadius="40"
                            Background="White"
                            Margin="0,0,0,20"
                            Opacity="0"
                            HorizontalAlignment="Center"/>

                    <!-- Текст приветствия -->
                    <TextBlock x:Name="WelcomeText" 
                               Text="Г'день, User Name"
                               Style="{StaticResource WelcomeTextStyle}"
                               Opacity="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

