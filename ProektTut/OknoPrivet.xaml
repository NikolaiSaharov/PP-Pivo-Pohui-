<UserControl x:Class="Sound_Player.OknoPrivet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Key="WelcomeAnimation">
            <!-- Начало: появление -->
            <DoubleAnimation Storyboard.TargetName="BackgroundOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.3" Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="WelcomeWindow"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1"/>

            <!-- Анимация логотипа -->
            <DoubleAnimation Storyboard.TargetName="LogoContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1"
                             BeginTime="0:0:0.5"/>
            <ThicknessAnimation Storyboard.TargetName="LogoContainer"
                               Storyboard.TargetProperty="Margin"
                               From="0,40,0,0" To="0,60,0,0" Duration="0:0:1"
                               BeginTime="0:0:0.5"/>

            <DoubleAnimation Storyboard.TargetName="WelcomeText"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1"
                             BeginTime="0:0:1"/>
            <ThicknessAnimation Storyboard.TargetName="WelcomeText"
                               Storyboard.TargetProperty="Margin"
                               From="0,20,0,0" To="0,0,0,0" Duration="0:0:1"
                               BeginTime="0:0:1"/>

            <DoubleAnimation Storyboard.TargetName="UserAvatar"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1"
                             BeginTime="0:0:1.5"/>
            <ThicknessAnimation Storyboard.TargetName="UserAvatar"
                               Storyboard.TargetProperty="Margin"
                               From="0,20,0,0" To="0,0,0,0" Duration="0:0:1"
                               BeginTime="0:0:1.5"/>

            <!-- Конец: плавное исчезновение (только затухание) -->
            <DoubleAnimation Storyboard.TargetName="WelcomeWindow"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:1"
                             BeginTime="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="BackgroundOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0" Duration="0:0:1"
                             BeginTime="0:0:3"/>
        </Storyboard>

        <Style TargetType="TextBlock" x:Key="WelcomeTextStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="68"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LogoTextStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Archivo Black"/>
            <Setter Property="FontSize" Value="47"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainGrid">
        <!-- Градиентный фон -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2A4A9F" Offset="0"/>
                    <GradientStop Color="#3E6BCF" Offset="0.5"/>
                    <GradientStop Color="#5A8CFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Затемнение фона -->
        <Rectangle x:Name="BackgroundOverlay" Fill="Black" Opacity="0"/>

        <!-- Основной контейнер -->
        <Grid x:Name="WelcomeContainer" VerticalAlignment="Stretch" HorizontalAlignment="Center">
            <Grid x:Name="WelcomeWindow" 
                  Opacity="0">
                <!-- Логотип GILS с иконкой -->
                <StackPanel x:Name="LogoContainer"
                            Orientation="Vertical" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top" 
                            Margin="0,60,0,0"
                            Opacity="0">
                    <svgc:SvgViewbox Source="/Resources/Images/Logotype_White.svg"
                                     Width="83" Height="75"
                                     Margin="0,0,0,10" 
                                     HorizontalAlignment="Center"/>
                    <TextBlock Text="GILS"
                               Style="{StaticResource LogoTextStyle}"/>
                </StackPanel>

                <!-- Центральная часть с аватаркой и текстом -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center">
                    <Border x:Name="UserAvatar"
                            Width="103" Height="103" 
                            CornerRadius="50"
                            Background="White"
                            Margin="0,0,0,20"
                            Opacity="0"
                            HorizontalAlignment="Center"/>

                    <TextBlock x:Name="WelcomeText" 
                               Text="Г'день, User Name"
                               Style="{StaticResource WelcomeTextStyle}"
                               Opacity="0"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
